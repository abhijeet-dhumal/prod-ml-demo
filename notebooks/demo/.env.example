# SmartShop Demo — environment variables
# Copy to .env and fill in values. Secrets are injected via K8s DataConnection
# or `make setup-secrets`; only override here if running locally.

# ── Required (no sane default) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REDIS_PASSWORD=

# ── Optional (defaults work on-cluster) ─────────────────────────────
# NAMESPACE=smartshop
# S3_ENDPOINT_URL=http://minio.smartshop.svc.cluster.local:9000
# REDIS_HOST=redis.smartshop.svc.cluster.local
# REDIS_PORT=6379
# MILVUS_HOST=milvus.smartshop.svc.cluster.local
# MILVUS_PORT=19530

# ── Container images (override for your own registry) ───────────────
# REGISTRY=quay.io/<your-org>
# REC_SERVER_IMAGE=quay.io/<your-org>/smartshop-rec-server:latest
# RAG_SERVER_IMAGE=quay.io/<your-org>/smartshop-rag-server:latest
# FEAST_SERVER_IMAGE=quay.io/<your-org>/smartshop-feast-spark-server:latest
# DEMO_UI_IMAGE=quay.io/<your-org>/smartshop-demo-ui:latest

# ── Models ──────────────────────────────────────────────────────────
# LLM_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HF_TOKEN=        # required for gated models
